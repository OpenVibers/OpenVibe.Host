{
  "_about": "Example ovhost inventory for the single OpenVibe host (openvibe-oregon). Copy to /etc/openvibe/host.json (root:root, 0640) and correct anything that differs on the machine; the real file is never committed. Paths, units, ports and env file locations come from OpenVibe.Network docs/roadmap-baseline/data/services.json and prod-snapshot.json (22 Sep 2026) and each repository's deploy/ directory. env.required lists NAMES only.",
  "host": "openvibe-oregon",
  "stateDir": "/var/lib/openvibe-host",
  "backupDir": "/var/backups/openvibe",
  "backupStagingDir": "/var/backups/openvibe.staging",
  "drillDir": "/var/lib/openvibe-drills",
  "_drill": "Restore drills (ovhost drill <service>): each service with a database has a drill block. The drill port is the service port + 10000 on 127.0.0.1. http://127.0.0.1:9 is a closed port, used where an empty value would fall back to a production service on loopback. An empty OV_OAUTH_CLIENT_SECRET stops a service from minting service tokens, so it cannot call other services with its identity. Loopback stays reachable from the drill sandbox (services need Network's public keys), so these overrides are what keep a drill away from production. _notes explain what is left on and why.",
  "nginx": {
    "sitesAvailable": "/etc/nginx/sites-available",
    "sitesEnabled": "/etc/nginx/sites-enabled",
    "bin": "nginx"
  },
  "defaults": {
    "owner": "ubuntu",
    "runAs": "ubuntu",
    "remote": "origin",
    "branch": "main"
  },
  "services": {
    "network": {
      "repo": "/opt/openvibe.network",
      "units": ["openvibe-network.service"],
      "unitSources": { "openvibe-network.service": "deploy/systemd/openvibe-network.service" },
      "envFile": "/etc/openvibe/network.env",
      "env": { "required": ["BASE_URL", "JWT_PRIVATE_KEY", "JWT_PUBLIC_KEY", "DB_PATH"] },
      "port": 4000,
      "ready": { "url": "http://127.0.0.1:4000/api/ready", "timeoutSeconds": 30 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "databases": [{ "name": "network", "path": "/opt/openvibe.network/data/network.db" }],
      "nginx": { "vhost": "openvibe.network.conf", "repoVhost": "deploy/nginx/openvibe.network.conf", "variant": "http" },
      "drill": {
        "port": 14000,
        "ready": "/api/ready",
        "databases": { "network": "DB_PATH" },
        "env": { "PORT": "{port}", "HOST": "127.0.0.1", "OV_EVENTS_INTERNAL_URL": "", "INTERNAL_API_KEY": "", "OV_TOOLS_INTERNAL_URL": "http://127.0.0.1:9", "AVATAR_PATH": "{tmp}/avatars" },
        "dirs": ["{tmp}/avatars"],
        "compare": [
          "/api/health",
          "/api/.well-known/jwks",
          "/api/brand",
          "/api/themes?limit=500",
          "/api/domains",
          "/api/v1/registry/capabilities"
        ],
        "counts": [{ "db": "network", "table": "users" }, { "db": "network", "table": "oauth_clients" }, { "db": "network", "table": "wallets" }, { "db": "network", "table": "coin_transactions" }],
        "_notes": "OV_EVENTS_INTERNAL_URL empty stops the dev_audit relay; INTERNAL_API_KEY empty falls back to the placeholder key, which makes the chrome site-copy job (paid LLM call through Live), avatar import and Live analytics calls return early. No switch: the ecosystem poller GETs every service readiness and release.json on loopback every 60 s (read-only). Discord bot login and the Resend email queue are gated by settings in the copy and reach only remote hosts, which the sandbox blocks. JWT_PRIVATE_KEY/JWT_PUBLIC_KEY come from the production env file and are only read."
      }
    },
    "live": {
      "repo": "/opt/openvibe.live",
      "units": ["openvibe-live.service"],
      "socketUnit": "openvibe-live.socket",
      "unitSources": {
        "openvibe-live.service": "deploy/systemd/openvibe-live.service",
        "openvibe-live.socket": "deploy/systemd/openvibe-live.socket",
        "openvibe-live.service.d/socket.conf": "deploy/systemd/openvibe-live.service.d/socket.conf"
      },
      "envFile": "/etc/openvibe/live.env",
      "env": { "required": ["BASE_URL", "JWT_SECRET", "OV_NETWORK_URL", "OV_OAUTH_CLIENT_ID", "OV_OAUTH_CLIENT_SECRET", "MEDIA_URL", "MEDIA_API_KEY", "MEDIA_WEBHOOK_SECRET"] },
      "port": 3000,
      "ready": { "url": "http://127.0.0.1:3000/api/ready", "timeoutSeconds": 90 },
      "noRestartPaths": ["public/", "docs/", "test/", "scripts/", "hardware/", "deploy/nginx/", "deploy/cloudflare/", "deploy/fail2ban/", "**/*.md"],
      "protected": {
        "kind": "http-json-count",
        "url": "http://127.0.0.1:3000/api/streams",
        "array": "streams",
        "where": { "is_live": true },
        "label": "live streams"
      },
      "drain": { "policy": "refuse", "waitMaxSeconds": 28800, "pollSeconds": 60, "quietChecks": 2 },
      "databases": [
        { "name": "live", "path": "/opt/openvibe.live/data/live.db" },
        { "name": "rs-companion", "path": "/opt/openvibe.live/data/rs-companion.db" }
      ],
      "_databasesNote": "analytics.db (1.7 GB, append-only pageviews) is left out of routine backups on purpose; add it here to include it.",
      "backupOnChange": ["server/db/migrations.js", "server/db/schema.sql"],
      "nginx": { "vhost": "openvibe.live.conf", "repoVhost": "deploy/nginx/openvibe.live.conf", "variant": "websocket", "wsPaths": ["/ws/"], "maxBody": "3m" },
      "drill": {
        "supported": false,
        "reason": "server/index.js opens data/analytics.db relative to the checkout (not movable by env) at module load: in the sandbox the checkout is read-only and boot fails, and without the sandbox the drill would write production's analytics database. It also always binds RTMP (RTMP_PORT and RTMP_PORT+8000), resumes restreams/RobotStreamer relays and AI jobs for rows in the copy, and runs Media reconcilers; several have no env switch. Needs a BindPaths over data/ plus DB-level switches before it can be drilled."
      }
    },
    "media": {
      "repo": "/opt/openvibe.media",
      "units": ["openvibe-media.service"],
      "unitSources": { "openvibe-media.service": "deploy/systemd/openvibe-media.service" },
      "envFile": "/etc/openvibe/media.env",
      "env": { "required": ["DB_PATH", "VOD_PATH", "MEDIA_B2_ENDPOINT", "MEDIA_B2_BUCKET", "MEDIA_B2_KEY_ID", "MEDIA_B2_APP_KEY", "MEDIA_R2_ENDPOINT", "MEDIA_R2_BUCKET", "MEDIA_R2_ACCESS_KEY_ID", "MEDIA_R2_SECRET_ACCESS_KEY"] },
      "port": 4100,
      "ready": { "url": "http://127.0.0.1:4100/api/ready", "timeoutSeconds": 60 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "protected": {
        "kind": "sqlite-count",
        "db": "/opt/openvibe.media/data/media.db",
        "sql": "SELECT count(*) AS n FROM vods WHERE is_recording = 1",
        "label": "recordings in progress"
      },
      "drain": { "policy": "refuse", "waitMaxSeconds": 43200, "pollSeconds": 60, "quietChecks": 2 },
      "databases": [{ "name": "media", "path": "/opt/openvibe.media/data/media.db" }],
      "nginx": { "vhost": "openvibe.media.conf", "repoVhost": "deploy/nginx/openvibe.media.conf", "variant": "http" },
      "drill": {
        "supported": false,
        "reason": "Webhooks to Live (orphan-recording finalize at boot, clip re-cuts, storage alerts) read their URL from the apps table and have no env switch; the health job, junk sweep and clip jobs run ffmpeg against production files through absolute paths stored in the database; the tiering sweep and health job start on a timer with no switch. A side-effect-free instance needs the copy edited (webhook_url NULL, storage_tier off) first, which ovhost does not do."
      }
    },
    "tools": {
      "repo": "/opt/openvibe.tools",
      "packages": ["apps/*"],
      "units": [
        "openvibe-tools.service",
        "openvibe-tools-maps.service",
        "openvibe-tools-food.service",
        "openvibe-tools-img.service",
        "openvibe-tools-yt.service",
        "openvibe-tools-audio.service",
        "openvibe-tools-text.service",
        "openvibe-tools-docs.service"
      ],
      "envFile": "/etc/openvibe/tools.env",
      "env": { "required": ["OV_NETWORK_URL", "OV_OAUTH_CLIENT_ID", "OV_OAUTH_CLIENT_SECRET", "MEDIA_URL"] },
      "port": 4001,
      "ready": { "url": "http://127.0.0.1:4001/api/ready", "headers": { "Host": "openvibe.tools" }, "timeoutSeconds": 60 },
      "noRestartPaths": ["**/*.md"],
      "databases": [
        { "name": "tools-audio-analytics", "path": "/opt/openvibe.tools/apps/audio/data/analytics.db" },
        { "name": "tools-docs-analytics", "path": "/opt/openvibe.tools/apps/docs/data/analytics.db" },
        { "name": "tools-food-analytics", "path": "/opt/openvibe.tools/apps/food/data/analytics.db" },
        { "name": "tools-img-analytics", "path": "/opt/openvibe.tools/apps/img/data/analytics.db" },
        { "name": "tools-maps-analytics", "path": "/opt/openvibe.tools/apps/maps/data/analytics.db" },
        { "name": "tools-text-analytics", "path": "/opt/openvibe.tools/apps/text/data/analytics.db" },
        { "name": "tools-yt-analytics", "path": "/opt/openvibe.tools/apps/yt/data/analytics.db" },
        { "name": "tools-audio-jobs", "path": "/opt/openvibe.tools/apps/audio/data/jobs.db" },
        { "name": "tools-docs-jobs", "path": "/opt/openvibe.tools/apps/docs/data/jobs.db" },
        { "name": "tools-img-jobs", "path": "/opt/openvibe.tools/apps/img/data/jobs.db" }
      ],
      "drill": {
        "supported": false,
        "reason": "Eight units (gateway plus seven apps) run as separate processes and a drill starts one; yt, food and maps open apps/<app>/data/analytics.db relative to the checkout with no env override (read-only in the sandbox, production's file without it); the job runtimes prune and re-queue jobs at start with no switch. Its only databases are per-app analytics."
      }
    },
    "community": {
      "repo": "/opt/openvibe.community",
      "units": ["openvibe-community.service"],
      "unitSources": { "openvibe-community.service": "deploy/systemd/openvibe-community.service" },
      "envFile": "/etc/openvibe/community.env",
      "env": { "required": ["BASE_URL", "OV_NETWORK_URL", "OV_OAUTH_CLIENT_ID", "OV_OAUTH_CLIENT_SECRET", "OV_OAUTH_REDIRECT_URI"] },
      "port": 4200,
      "ready": { "url": "http://127.0.0.1:4200/api/ready", "timeoutSeconds": 30 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "databases": [
        { "name": "community", "path": "/var/lib/openvibe-community/community.db" },
        { "name": "community-legacy-path", "path": "/opt/openvibe.community/data/community.db" }
      ],
      "_databasesNote": "The repo unit puts the database in /var/lib/openvibe-community; the 22 Sep production snapshot found it under /opt/openvibe.community/data. Keep the one that exists (backup skips a missing path).",
      "nginx": { "vhost": "openvibe.community.conf", "repoVhost": "deploy/nginx/openvibe.community.conf", "variant": "http" },
      "drill": {
        "port": 14200,
        "databases": { "community": "COMMUNITY_DB_PATH" },
        "env": { "PORT": "{port}", "HOST": "127.0.0.1", "DISCORD_RELAY_ENABLED": "0", "OV_OAUTH_CLIENT_SECRET": "", "OV_LIVE_INTERNAL_URL": "http://127.0.0.1:9", "OV_MEDIA_INTERNAL_URL": "http://127.0.0.1:9" },
        "compare": [
          "/api/pastes?limit=5",
          "/api/v1/spaces",
          "/api/v1/pulse?limit=5"
        ],
        "counts": [{ "db": "community", "table": "pastes" }, { "db": "community", "table": "spaces" }, { "db": "community", "table": "threads" }, { "db": "community", "table": "posts" }],
        "_notes": "If the host keeps the database at the legacy path, map \"community-legacy-path\" instead of \"community\" (and in counts). An empty client secret stops identity resolve-batch calls to Network; the dead Live URL makes a PASTES_AUTHORITY=live proxy fail visibly instead of matching production through production. Community has no events relay (EVENTS_URL is unused)."
      }
    },
    "events": {
      "_note": "Not deployed as of the 22 Sep 2026 production snapshot (no events.env on the host).",
      "repo": "/opt/openvibe.events",
      "units": ["openvibe-events.service"],
      "unitSources": { "openvibe-events.service": "deploy/systemd/openvibe-events.service" },
      "envFile": "/etc/openvibe/events.env",
      "env": { "required": ["OV_NETWORK_URL", "OV_NETWORK_INTERNAL_URL"] },
      "port": 4300,
      "ready": { "url": "http://127.0.0.1:4300/api/ready", "timeoutSeconds": 30 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "protected": {
        "kind": "http-json-count",
        "url": "http://127.0.0.1:4300/api/ready",
        "field": "realtime_connections",
        "label": "SSE connections"
      },
      "drain": { "policy": "report" },
      "databases": [{ "name": "events", "path": "/var/lib/openvibe-events/events.db" }],
      "nginx": { "vhost": "events.openvibe.network.conf", "repoVhost": "deploy/nginx/events.openvibe.network.conf", "variant": "sse", "ssePaths": ["/realtime/stream"], "certName": "openvibe.network" },
      "drill": {
        "port": 14300,
        "databases": { "events": "EVENTS_DB_PATH" },
        "env": { "PORT": "{port}", "HOST": "127.0.0.1", "EVENTS_WORKER": "off" },
        "counts": [{ "db": "events", "table": "events" }, { "db": "events", "table": "subscriptions" }, { "db": "events", "table": "deliveries" }, { "db": "events", "table": "consumer_checkpoints" }],
        "_notes": "EVENTS_WORKER=off stops signed deliveries to subscribers. /api/ready requires Network JWKS (read-only GET on loopback). The retention prune interval always runs but only touches the copy. No public read endpoint is stable enough to compare; row counts only."
      }
    },
    "games": {
      "repo": "/opt/openvibe.games",
      "managed": false,
      "unmanagedReason": "pnpm workspace with a TypeScript build; its deploy steps are not encoded in Stage A (status, validate, snapshot and backup still work)",
      "units": ["openvibe-games.service"],
      "envFile": "/etc/openvibe/games.env",
      "port": 8000,
      "ready": { "url": "http://127.0.0.1:8000/api/ready", "timeoutSeconds": 60 },
      "databases": [{ "name": "world", "path": "/opt/openvibe.games/data/world.db" }],
      "drill": {
        "supported": false,
        "reason": "Not reviewed: a pnpm workspace with a TypeScript build whose runtime side effects (world simulation loop, realtime ports) have not been read, so no side-effect-free overrides can be declared without guessing."
      }
    },
    "sites": {
      "repo": "/opt/openvibe.sites",
      "units": [],
      "install": { "command": ["npm", "ci", "--omit=dev", "--no-audit", "--no-fund"], "always": true },
      "build": [["node", "build.js"]],
      "nginx": { "repoVhosts": "deploy/nginx/*.conf", "installOnDeploy": true }
    },
    "host": {
      "_note": "OpenVibe.Host Stage B (tenant static hosting): the Host API service on port 4910. Not deployed as of 22 Sep 2026. Its database and content-addressed objects live in /var/lib/openvibe-host-api, which is NOT ovhost's own stateDir (/var/lib/openvibe-host). Tenant vhosts: `ovhost nginx tenants host`.",
      "repo": "/opt/openvibe.host",
      "units": ["openvibe-host.service"],
      "unitSources": { "openvibe-host.service": "deploy/systemd/openvibe-host.service" },
      "envFile": "/etc/openvibe/host.env",
      "env": { "required": ["BASE_URL", "OV_NETWORK_URL", "OV_OAUTH_CLIENT_ID", "OV_OAUTH_CLIENT_SECRET", "HOST_FORM_SECRET", "HOST_SITES_DOMAIN"] },
      "port": 4910,
      "ready": { "url": "http://127.0.0.1:4910/api/ready", "timeoutSeconds": 30 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "databases": [{ "name": "host", "path": "/var/lib/openvibe-host-api/host.db" }],
      "nginx": { "tenants": { "sitesDomain": "openvibe.host", "dashboardDomain": "openvibe.host", "wildcardCert": "openvibe.host", "database": "/var/lib/openvibe-host-api/host.db", "maxUpload": "110m" } },
      "drill": {
        "port": 14910,
        "databases": { "host": "HOST_DB_PATH" },
        "env": { "PORT": "{port}", "HOST": "127.0.0.1", "HOST_WORKER": "off", "EVENTS_URL": "", "OV_OAUTH_CLIENT_SECRET": "", "HOST_STORAGE_DIR": "{tmp}/objects" },
        "dirs": ["{tmp}/objects"],
        "counts": [{ "db": "host", "table": "host_projects" }, { "db": "host", "table": "host_sites" }, { "db": "host", "table": "host_deploys" }, { "db": "host", "table": "host_domains" }],
        "_notes": "Restores host.db only: `ovhost backup host` does not copy the content-addressed objects, so tenant content cannot be compared (every /api/v1 read needs auth). HOST_WORKER=off stops DNS rechecks and the object sweep."
      }
    },
    "billing": {
      "_note": "Not deployed as of the 22 Sep 2026 production snapshot; unit, env file, port and database path from the repository's deploy/ directory.",
      "repo": "/opt/openvibe.billing",
      "units": ["openvibe-billing.service"],
      "unitSources": { "openvibe-billing.service": "deploy/systemd/openvibe-billing.service" },
      "envFile": "/etc/openvibe/billing.env",
      "env": { "required": "from-example" },
      "port": 4600,
      "ready": { "url": "http://127.0.0.1:4600/api/ready", "timeoutSeconds": 30 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "databases": [{ "name": "billing", "path": "/var/lib/openvibe-billing/billing.db" }],
      "drill": {
        "port": 14600,
        "databases": { "billing": "BILLING_DB_PATH" },
        "env": { "PORT": "{port}", "HOST": "127.0.0.1", "BILLING_JOBS": "off", "EVENTS_URL": "", "OV_OAUTH_CLIENT_SECRET": "" },
        "compare": ["/api/v1/rates"],
        "counts": [{ "db": "billing", "table": "accounts" }, { "db": "billing", "table": "transactions" }, { "db": "billing", "table": "ledger_entries" }, { "db": "billing", "table": "subscriptions" }, { "db": "billing", "table": "payment_intents" }],
        "_notes": "BILLING_JOBS=off stops provider-event settlement, the renewal sweep and the outbox relay. Payment providers are called only on incoming requests (and are remote, which the sandbox blocks). /api/health is not compared: it reports the relay state, which the drill turns off."
      }
    },
    "chat": {
      "_note": "Not deployed as of the 22 Sep 2026 production snapshot; unit, env file, port and database path from the repository's deploy/ directory.",
      "repo": "/opt/openvibe.chat",
      "units": ["openvibe-chat.service"],
      "unitSources": { "openvibe-chat.service": "deploy/systemd/openvibe-chat.service" },
      "envFile": "/etc/openvibe/chat.env",
      "env": { "required": "from-example" },
      "port": 4400,
      "ready": { "url": "http://127.0.0.1:4400/ready", "timeoutSeconds": 30 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "databases": [{ "name": "chat", "path": "/var/lib/openvibe-chat/chat.db" }],
      "drill": {
        "port": 14400,
        "databases": { "chat": "CHAT_DB_PATH" },
        "env": { "PORT": "{port}", "HOST": "127.0.0.1", "EVENTS_URL": "", "LIVE_MIRROR": "0", "OV_OAUTH_CLIENT_SECRET": "", "OV_LIVE_INTERNAL_URL": "http://127.0.0.1:9", "CHAT_CACHE_DIR": "{tmp}/cache", "SOUNDS_PATH": "{tmp}/sounds" },
        "dirs": ["{tmp}/cache", "{tmp}/sounds"],
        "compare": ["/api/chat/filters/friendly"],
        "counts": [{ "db": "chat", "table": "dm_conversations" }, { "db": "chat", "table": "dm_messages" }, { "db": "chat", "table": "emotes" }, { "db": "chat", "table": "moderation_actions" }],
        "_notes": "An empty client secret and a dead Live URL stop the 2 s Live projection sync and the effects POSTed to Live. History endpoints are not compared: cosmetics come from Live (cut off here) and expired messages are swept at boot, so chat_messages is not counted either."
      }
    },
    "search": {
      "_note": "Not deployed as of the 22 Sep 2026 production snapshot; unit, env file, port and database path from the repository's deploy/ directory.",
      "repo": "/opt/openvibe.search",
      "units": ["openvibe-search.service"],
      "unitSources": { "openvibe-search.service": "deploy/systemd/openvibe-search.service" },
      "envFile": "/etc/openvibe/search.env",
      "env": { "required": "from-example" },
      "port": 4710,
      "ready": { "url": "http://127.0.0.1:4710/api/ready", "timeoutSeconds": 30 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "databases": [{ "name": "search", "path": "/var/lib/openvibe-search/search.db" }],
      "drill": {
        "port": 14710,
        "databases": { "search": "SEARCH_DB_PATH" },
        "env": { "PORT": "{port}", "HOST": "127.0.0.1", "EVENTS_URL": "", "SEARCH_EVENTS_SECRET": "", "OV_OAUTH_CLIENT_SECRET": "" },
        "compare": [
          "/api/v1/search?q=openvibe&limit=10",
          "/api/v1/suggest?q=open&limit=10"
        ],
        "counts": [{ "db": "search", "table": "documents" }, { "db": "search", "table": "doc_acl" }, { "db": "search", "table": "doc_facets" }],
        "_notes": "/api/ready needs the Network public key (read-only JWKS GET on loopback). No switch: the 6-hourly outbox prune (copy only)."
      }
    },
    "sources": {
      "_note": "Not deployed as of the 22 Sep 2026 production snapshot; unit, env file, port and database path from the repository's deploy/ directory.",
      "repo": "/opt/openvibe.sources",
      "units": ["openvibe-sources.service"],
      "unitSources": { "openvibe-sources.service": "deploy/systemd/openvibe-sources.service" },
      "envFile": "/etc/openvibe/sources.env",
      "env": { "required": "from-example" },
      "port": 4720,
      "ready": { "url": "http://127.0.0.1:4720/api/ready", "timeoutSeconds": 30 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "databases": [{ "name": "sources", "path": "/var/lib/openvibe-sources/sources.db" }],
      "drill": {
        "port": 14720,
        "databases": { "sources": "SOURCES_DB_PATH" },
        "env": { "PORT": "{port}", "HOST": "127.0.0.1", "SOURCES_WORKER": "off", "EVENTS_URL": "", "OV_OAUTH_CLIENT_SECRET": "" },
        "counts": [{ "db": "sources", "table": "sources" }, { "db": "sources", "table": "items" }, { "db": "sources", "table": "item_revisions" }, { "db": "sources", "table": "fetch_runs" }],
        "_notes": "SOURCES_WORKER=off stops the crawler (feeds, sitemaps, robots.txt; production may allow loopback sources). Every /api/v1 read needs a service token, so row counts only."
      }
    },
    "wiki": {
      "_note": "Not deployed as of the 22 Sep 2026 production snapshot; unit, env file, port and database path from the repository's deploy/ directory.",
      "repo": "/opt/openvibe.wiki",
      "units": ["openvibe-wiki.service"],
      "unitSources": { "openvibe-wiki.service": "deploy/systemd/openvibe-wiki.service" },
      "envFile": "/etc/openvibe/wiki.env",
      "env": { "required": "from-example" },
      "port": 4800,
      "ready": { "url": "http://127.0.0.1:4800/api/ready", "timeoutSeconds": 30 },
      "noRestartPaths": ["docs/", "test/", "**/*.md"],
      "databases": [{ "name": "wiki", "path": "/var/lib/openvibe-wiki/wiki.db" }],
