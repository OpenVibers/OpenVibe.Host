
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{hostname}};

    ssl_certificate     {{certDir}}/fullchain.pem;
    ssl_certificate_key {{certDir}}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/sites.{{sitesDomain}}.access.log;
    error_log  /var/log/nginx/sites.{{sitesDomain}}.error.log;
{{tenantLocation}}
}
