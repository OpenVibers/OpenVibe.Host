## ═══════════════════════════════════════════════════════════════
## {{dashboard}} and *.{{sitesDomain}} — generated by `ovhost nginx tenants {{service}}`
##
## OpenVibe.Host Stage B (tenant static hosting), port {{port}}.
##   {{dashboard}}          the dashboard and the Host API (/api/v1), uploads up to {{maxUpload}}
##   *.{{sitesDomain}}      tenant sites: GET/HEAD only, cookies stripped both ways
## Wildcard certificate: {{certDir}} (issued by the operator with a DNS-01 challenge; see README).
## `--install` writes {{sitesAvailable}}/{{vhost}}, links it, and reloads nginx only if `nginx -t` passes.
## ═══════════════════════════════════════════════════════════════

limit_req_zone $binary_remote_addr zone={{zone}}_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone={{zone}}_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone={{zone}}_sites:20m rate=50r/s;

# ── HTTP → HTTPS ───────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name {{dashboard}} *.{{sitesDomain}};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

# ── Dashboard + API ────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{dashboard}};
    include snippets/security-txt.conf;   # /.well-known/security.txt (the host's file; WS-R task 7)

    ssl_certificate     {{certDir}}/fullchain.pem;
    ssl_certificate_key {{certDir}}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/{{dashboard}}.access.log;
    error_log  /var/log/nginx/{{dashboard}}.error.log;

    client_max_body_size 1m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header CF-Connecting-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /auth/ {
        limit_req zone={{zone}}_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:{{port}};
    }

    # Deploy uploads (API and dashboard form): large bodies, streamed to the service.
    location ~ ^/(api/v1/)?sites/[A-Za-z0-9_]+/deploys$ {
        limit_req zone={{zone}}_api burst=10 nodelay;
        client_max_body_size {{maxUpload}};
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_pass http://127.0.0.1:{{port}};
    }

    location /api/ {
        limit_req zone={{zone}}_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:{{port}};
    }

    # Prometheus metrics: host-local scrapers only (http://127.0.0.1:{{port}}/metrics).
    location = /metrics { return 404; }

    location / {
        limit_req zone={{zone}}_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:{{port}};
    }
}

{{wwwRedirect}}# ── Tenant sites ───────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name *.{{sitesDomain}};

    ssl_certificate     {{certDir}}/fullchain.pem;
    ssl_certificate_key {{certDir}}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/sites.{{sitesDomain}}.access.log;
    error_log  /var/log/nginx/sites.{{sitesDomain}}.error.log;
{{tenantLocation}}
}
