# OpenVibe.Host catalog service. Production: /etc/openvibe/host.env.
PORT=4910
HOST=127.0.0.1
NODE_ENV=development
BASE_URL=http://localhost:4910
# IndexNow: with a key (8–128 letters and digits), new and repriced catalog pages are sent to search engines and the key
# is served at /<key>.txt. Unset: off.
#INDEXNOW_KEY=
TRUST_PROXY=1
DATABASE_URL=
DATABASE_DIRECT_URL=
#HOST_PGLITE_DIR=
VALKEY_URL=
VALKEY_PREFIX=
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
OV_OAUTH_CLIENT_ID=host
OV_OAUTH_CLIENT_SECRET=
#OV_OAUTH_REDIRECT_URI=
#COOKIE_SECURE=false
HOST_FORM_SECRET=
#EVENTS_URL=
#EVENTS_RELAY_INTERVAL_MS=2000
#HOST_LIMITS_MINUTE=120
#HOST_LIMITS_HOUR=3000
#HOST_ACTOR_LIMITS=on
#HOST_WORKER=on
#HOST_WORKER_ID=
HOST_CATALOG_INGEST=off
HOST_CATALOG_SOURCES_URL=
HOST_CATALOG_WEBHOOK_SECRETS=
HOST_COMMUNITY_URL=
OV_COMMUNITY_URL=https://openvibe.community
OV_WATCH_URL=https://openvibe.watch

# The console (server/console/): seals people's hosting API tokens (32 bytes, hex or base64). Unset: the console connects nothing.
#HOST_CREDENTIALS_KEY=
#HOST_CONSOLE_MAX_ACCOUNTS=10
# OpenVibe.Events → Host (account export and deletion): signs deliveries to /internal/events (32+ characters).
#HOST_EVENTS_SECRET=
