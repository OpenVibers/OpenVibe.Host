# ═══════════════════════════════════════════════════════════════
# OpenVibe.Host Stage B (tenant static hosting): environment (names only; never commit values)
# Copy to .env for development. Production: /etc/openvibe/host.env (0600).
# Stage A (the ovhost CLI) reads no environment beyond OVHOST_INVENTORY.
# ═══════════════════════════════════════════════════════════════

# Server
PORT=4910
HOST=127.0.0.1
NODE_ENV=development
# The dashboard + API origin (production: https://openvibe.host)
BASE_URL=http://localhost:4910
# Proxy hops in front of Node that set X-Forwarded-For. nginx resolves the Cloudflare hop itself
# (realip) and sends only $remote_addr, so there is one: nginx → Node = 1.
TRUST_PROXY=1

# Tenant sites are served at <site>.<HOST_SITES_DOMAIN>. It must be its own registrable domain
# (never under openvibe.network / openvibe.live). Development: localhost (http://<site>.localhost:4910)
HOST_SITES_DOMAIN=openvibe.host

# SQLite database and content-addressed objects (the production unit sets both under
# /var/lib/openvibe-host-api)
HOST_DB_PATH=./data/host.db
HOST_STORAGE_DIR=./data/objects

# OpenVibe.Network — SSO (OAuth2), JWKS, client-credentials tokens
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# OAuth client `host` (redirect https://openvibe.host/auth/callback). The same client is Host's
# service principal svc:host for client-credentials grants (see README, "Grants").
OV_OAUTH_CLIENT_ID=host
OV_OAUTH_CLIENT_SECRET=
#OV_OAUTH_REDIRECT_URI=
# Cookies: Secure (and __Host- prefixed) by default in production; false for plain-http development
#COOKIE_SECURE=false
# Signs the dashboard form tokens (CSRF). Unset: random per process.
HOST_FORM_SECRET=

# OpenVibe.Events — the outbox relay runs only when EVENTS_URL and OV_OAUTH_CLIENT_SECRET are set
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=2000

# Largest request body for one deploy (bytes; nginx allows 110m on the upload routes)
#HOST_MAX_UPLOAD_BYTES=104857600
# Largest size an uploaded archive may unpack to (default 256 MiB; the storage quota also applies).
#HOST_MAX_UNPACKED_BYTES=268435456
# Uploads read and validated at the same time, service-wide; each is held in memory (up to the two
# limits above), so this bounds what concurrent uploads can cost. Others get 503 + Retry-After.
#HOST_MAX_CONCURRENT_UPLOADS=2

# Per-project quota defaults (a staff override per project wins). Production projects:
#HOST_QUOTA_STORAGE_BYTES=1073741824
#HOST_QUOTA_DEPLOYS_PER_DAY=50
#HOST_QUOTA_MAX_FILES=10000
#HOST_QUOTA_MAX_FILE_BYTES=26214400
#HOST_QUOTA_SITES=10
#HOST_QUOTA_CUSTOM_DOMAINS=5
# Sandbox projects:
#HOST_SANDBOX_QUOTA_STORAGE_BYTES=104857600
#HOST_SANDBOX_QUOTA_DEPLOYS_PER_DAY=20
#HOST_SANDBOX_QUOTA_MAX_FILES=2000
#HOST_SANDBOX_QUOTA_MAX_FILE_BYTES=10485760
#HOST_SANDBOX_QUOTA_SITES=3
#HOST_SANDBOX_QUOTA_CUSTOM_DOMAINS=0

# Custom domains: what the CNAME points at (default <site>.<HOST_SITES_DOMAIN>), origin addresses
# shown for apex domains, resolvers for TXT checks, timings
#HOST_CNAME_TARGET=
#HOST_ORIGIN_IPV4=
#HOST_ORIGIN_IPV6=
#HOST_DNS_SERVERS=1.1.1.1,8.8.8.8
#HOST_DOMAIN_RECHECK_MS=600000
#HOST_DOMAIN_PENDING_DAYS=7
#HOST_DOMAIN_LAPSE_DAYS=7
# Extra domains nobody may claim, and extra reserved site names (comma-separated)
#HOST_RESERVED_DOMAINS=
#HOST_RESERVED_SITE_NAMES=

# Background worker (domain checks, orphan-object sweep, outbox prune); off: HOST_WORKER=off
#HOST_WORKER=on
#HOST_WORKER_ID=

# Browser origins that may call /api/v1 with a Bearer Network JWT (never cookies)
#API_CORS_ORIGINS=https://openvibe.network,https://openvibe.codes

# release.json (openvibe-shared/release): the deployed commit when git is not available
#RELEASE_COMMIT=
#MIN_CLIENT_RELEASE=
