[Unit]
Description=OpenVibe backups: verify pgBackRest, create scheduled logical PostgreSQL dumps, then an encrypted off-host copy
Documentation=https://github.com/OpenVibers/OpenVibe.Host/blob/main/docs/backups.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root: ovhost uses the postgres OS user for dumps and pgBackRest verification and is the only reader of
# /etc/openvibe/backup.env, the encryption key and the root-only backups. The env file is read by
# ovhost itself, not loaded into this unit's environment.
User=root
# Local copies: the newest 2 days and the newest week. The encrypted off-host copy keeps 30 days and pgBackRest
# keeps its own (S3), so a local copy is only the fast restore. The 96 GB host ran out of room on 2026-11-17 with
# 8 GB of local copies (7 daily + 4 weekly): Media refused to record live streams for 15 minutes.
ExecStart=/usr/local/bin/ovhost backup --all --offsite --keep-daily 2 --keep-weekly 1
# /usr/sbin for runuser (lib/executor.js also resolves it by absolute path).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=OVHOST_INVENTORY=/etc/openvibe/host.json
UMask=0077
# 11-17: the production host has 4 cores and serves every site; this batch job yields to them (Nice 19, the smallest
# CPU share, idle IO). Interactive Node services showed up to 1.8 s of event-loop lag while checks and recordings ran.
Nice=19
CPUWeight=10
IOSchedulingClass=idle
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# A pg_dump has a six-hour limit, which also covers a whole run.
TimeoutStartSec=6h
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
