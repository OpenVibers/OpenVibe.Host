[Unit]
Description=OpenVibe backups: verify pgBackRest for the PostgreSQL services, dump SQLite databases and the scheduled logical PostgreSQL dumps, then an encrypted off-host copy
Documentation=https://github.com/OpenVibers/OpenVibe.Host/blob/main/docs/backups.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root: ovhost drops to each service user for the SQLite backup and to the postgres OS user for the
# PostgreSQL dumps and the pgBackRest verification (runuser) and is the only reader of
# /etc/openvibe/backup.env, the encryption key and the root-only backups. The env file is read by
# ovhost itself, not loaded into this unit's environment.
User=root
ExecStart=/usr/local/bin/ovhost backup --all --offsite
# /usr/sbin for runuser (lib/executor.js also resolves it by absolute path).
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=OVHOST_INVENTORY=/etc/openvibe/host.json
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# The PostgreSQL logical dumps are the large ones now (they run as the postgres OS user), and the
# SQLite worker's own limit is 6 h per database; a pg_dump is given the same. 6 h covers a whole run.
TimeoutStartSec=6h
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
