[Unit]
Description=OpenVibe node registry: this inventory's machines and their measured health, reported to OpenVibe.Network
Documentation=https://github.com/OpenVibers/OpenVibe.Host/blob/main/docs/nodes.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root: /etc/openvibe/host.env (Host's service principal) is root-only and read by ovhost itself, and the
# textfile collector's directory is root's.
User=root
ExecStart=/usr/local/bin/ovhost nodes report
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=OVHOST_INVENTORY=/etc/openvibe/host.json
UMask=0077
TimeoutStartSec=90s
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
